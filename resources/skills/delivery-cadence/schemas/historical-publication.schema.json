{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheusags.ai/schemas/delivery-cadence/historical-publication.schema.json",
  "title": "Historical publication adoption request",
  "type": "object",
  "required": ["runId","authorityRefs","reason","release","expectedPredecessor","mappings"],
  "properties": {
    "runId": {"type":"string","minLength":1},
    "expectedRevision": {"type":"integer","minimum":0},
    "authorityRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"type":"string","minLength":1}
    },
    "reason": {"type":"string","minLength":1},
    "release": {"$ref":"#/$defs/release"},
    "expectedPredecessor": {
      "type": ["object","null"]
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref":"#/$defs/mapping"}
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": ["path","sha256"],
      "properties": {
        "path": {"type":"string","minLength":1},
        "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "envelope": {
      "type": "object",
      "required": ["schemaVersion","kind","status","releaseVersion","sourceRefs","verifiedAt","evidenceRefs"],
      "properties": {
        "schemaVersion": {"const":1},
        "kind": {
          "enum": ["source","build","launch","feature","platform","metadata","website","scope-coverage"]
        },
        "status": {"const":"success"},
        "releaseVersion": {"type":"string","minLength":1},
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["repository","revision"],
            "properties": {
              "repository": {"type":"string","minLength":1},
              "revision": {"type":"string","pattern":"^[a-f0-9]{40}$"}
            }
          }
        },
        "verifiedAt": {"type":"string","format":"date-time"},
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref":"#/$defs/evidenceRef"}
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["obligationId","candidateId","contentManifestDigest","evidence"],
      "properties": {
        "obligationId": {"type":"string","minLength":1},
        "candidateId": {"type":"string","minLength":1},
        "contentManifestDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "evidence": {"$ref":"#/$defs/evidenceRef"}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["kind","id","basis","reason","evidenceRefs"],
      "properties": {
        "kind": {
          "enum": ["tasks","changes","phases","outcomes"]
        },
        "id": {"type":"string","minLength":1},
        "basis": {
          "enum": ["observed-operation","source-applicability"]
        },
        "reason": {"type":"string","minLength":1},
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref":"#/$defs/evidenceRef"}
        }
      }
    },
    "release": {
      "type": "object",
      "required": ["id","version","targetId","publishedAt","sourceRefs","evidence"],
      "properties": {
        "id": {"type":"string","minLength":1},
        "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "targetId": {"type":"string","minLength":1},
        "publishedAt": {"type":"string","format":"date-time"},
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["repository","revision"],
            "properties": {
              "repository": {"type":"string","minLength":1},
              "revision": {"type":"string","pattern":"^[a-f0-9]{40}$"}
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["source","build","launch","feature","platforms","metadata","website"],
          "properties": {
            "source": {"$ref":"#/$defs/evidenceRef"},
            "build": {"$ref":"#/$defs/evidenceRef"},
            "launch": {"$ref":"#/$defs/evidenceRef"},
            "feature": {"$ref":"#/$defs/evidenceRef"},
            "metadata": {"$ref":"#/$defs/evidenceRef"},
            "website": {"$ref":"#/$defs/evidenceRef"},
            "platforms": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref":"#/$defs/evidenceRef"}
            }
          }
        }
      }
    },
    "externalRelease": {
      "type": "object",
      "required": ["id","digest","release","evidence","receipts","preservedEvidence","recordedAt","countedAsDelivery","countedCompletions"],
      "properties": {
        "id": {"type":"string","minLength":1},
        "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "release": {"$ref":"#/$defs/release"},
        "evidence": {
          "type": "object",
          "required": ["source","build","launch","feature","platforms","metadata","website"],
          "properties": {
            "source": {"$ref":"#/$defs/source"},
            "build": {"$ref":"#/$defs/build"},
            "launch": {"$ref":"#/$defs/launch"},
            "feature": {"$ref":"#/$defs/feature"},
            "metadata": {"$ref":"#/$defs/metadata"},
            "website": {"$ref":"#/$defs/website"},
            "platforms": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref":"#/$defs/platform"}
            }
          }
        },
        "receipts": {"type":"array"},
        "preservedEvidence": {"type":"array"},
        "recordedAt": {"type":"string","format":"date-time"},
        "countedAsDelivery": {"const":false},
        "countedCompletions": {"const":false}
      }
    },
    "publicationLink": {
      "type": "object",
      "required": ["id","digest","externalReleaseId","releaseDigest","obligationId","candidateId","contentManifestDigest","evidence","proof","effects","authorityRefs","reason","publishedAt","recordedAt"],
      "properties": {
        "id": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "externalReleaseId": {"type":"string","minLength":1},
        "releaseDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "obligationId": {"type":"string","minLength":1},
        "candidateId": {"type":"string","minLength":1},
        "contentManifestDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "evidence": {"$ref":"#/$defs/evidenceRef"},
        "proof": {"$ref":"#/$defs/scopeCoverage"},
        "effects": {
          "type": "array",
          "items": {"type":"string","minLength":1}
        },
        "authorityRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"type":"string","minLength":1}
        },
        "reason": {"type":"string","minLength":1},
        "publishedAt": {"type":"string","format":"date-time"},
        "recordedAt": {"type":"string","format":"date-time"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["platform","sha256"],
      "properties": {
        "platform": {"type":"string","minLength":1},
        "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "source": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": [],
          "properties": {
            "kind": {"const":"source"}
          }
        }
      ]
    },
    "build": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": ["startedAt","finishedAt","artifacts"],
          "properties": {
            "kind": {"const":"build"},
            "startedAt": {"type":"string","format":"date-time"},
            "finishedAt": {"type":"string","format":"date-time"},
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref":"#/$defs/artifact"}
            }
          }
        }
      ]
    },
    "launch": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": ["startedAt","finishedAt","artifact"],
          "properties": {
            "kind": {"const":"launch"},
            "startedAt": {"type":"string","format":"date-time"},
            "finishedAt": {"type":"string","format":"date-time"},
            "artifact": {"$ref":"#/$defs/artifact"}
          }
        }
      ]
    },
    "feature": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": ["startedAt","finishedAt","artifact","operationId","outcome"],
          "properties": {
            "kind": {"const":"feature"},
            "startedAt": {"type":"string","format":"date-time"},
            "finishedAt": {"type":"string","format":"date-time"},
            "artifact": {"$ref":"#/$defs/artifact"},
            "operationId": {"type":"string","minLength":1},
            "outcome": {"type":"string","minLength":1}
          }
        }
      ]
    },
    "platform": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": ["platform","architecture","sha256","size","url","signingStatus"],
          "properties": {
            "kind": {"const":"platform"},
            "platform": {"type":"string","minLength":1},
            "architecture": {"type":"string","minLength":1},
            "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
            "size": {"type":"integer","minimum":1},
            "url": {"type":"string","format":"uri"},
            "signingStatus": {
              "enum": ["signed","unsigned","unknown","ad-hoc"]
            }
          }
        }
      ]
    },
    "metadata": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": ["commit","url"],
          "properties": {
            "kind": {"const":"metadata"},
            "commit": {"type":"string","pattern":"^[a-f0-9]{40}$"},
            "url": {"type":"string","format":"uri"}
          }
        }
      ]
    },
    "website": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": ["url","deploymentId","links"],
          "properties": {
            "kind": {"const":"website"},
            "url": {"type":"string","format":"uri"},
            "deploymentId": {"type":"string","minLength":1},
            "links": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["platform","url","sha256","size","version"],
                "properties": {
                  "platform": {"type":"string","minLength":1},
                  "url": {"type":"string","minLength":1},
                  "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
                  "size": {"type":"integer","minimum":1},
                  "version": {"type":"string","minLength":1}
                }
              }
            }
          }
        }
      ]
    },
    "scopeCoverage": {
      "allOf": [
        {"$ref":"#/$defs/envelope"},
        {
          "type": "object",
          "required": ["candidateId","contentManifestDigest","candidateSourceRefs","coverage"],
          "properties": {
            "kind": {"const":"scope-coverage"},
            "candidateId": {"type":"string","minLength":1},
            "contentManifestDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
            "candidateSourceRefs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["repository","revision"],
                "properties": {
                  "repository": {"type":"string","minLength":1},
                  "revision": {"type":"string","pattern":"^[a-f0-9]{40}$"}
                }
              }
            },
            "coverage": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref":"#/$defs/coverage"}
            }
          }
        }
      ]
    }
  }
}
